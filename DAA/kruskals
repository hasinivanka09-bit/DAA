#include <stdio.h>
#define MAX 100
struct Edge {
    int u, v, w;
};
int parent[MAX];
int find(int x) {
    if (parent[x] == x)
        return x;
    return parent[x] = find(parent[x]);
}
void unionSet(int a, int b) {
    a = find(a);
    b = find(b);
    parent[a] = b;
}
int main() {
    int V, E;
    struct Edge edges[MAX], temp;
    printf("Enter number of vertices and edges: ");
    scanf("%d %d", &V, &E);
    printf("Enter edges (u v weight):\n");
    int i,j;
    for (i = 0; i < E; i++)
        scanf("%d %d %d",
              &edges[i].u, &edges[i].v, &edges[i].w);
    for (i = 0; i < E - 1; i++) {
        for (j = 0; j < E - i - 1; j++) {
            if (edges[j].w > edges[j + 1].w) {
                temp = edges[j];
                edges[j] = edges[j + 1];
                edges[j + 1] = temp;
            }
        }
    }
    for (i = 0; i < V; i++)
        parent[i] = i;
    int count = 0, cost = 0;
    printf("\nEdges in MST:\n");
    for (i = 0; i < E && count < V - 1; i++) {
        int u = edges[i].u;
        int v = edges[i].v;
        if (find(u) != find(v)) {
            printf("%d - %d : %d\n",
                   u, v, edges[i].w);
            cost += edges[i].w;
            unionSet(u, v);
            count++;
        }
    }
    if (count != V - 1)
        printf("MST not possible (graph disconnected)\n");
    else
        printf("Total MST cost = %d\n", cost);

    return 0;
}
